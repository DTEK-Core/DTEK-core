# ─────────────────────────────────────────────
# DTEK Core — переменные окружения
# Скопируй этот файл в .env.local и заполни значениями.
# ─────────────────────────────────────────────

# Supabase Project URL
# Найти: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon (Public) Key
# Найти: Supabase Dashboard → Settings → API → Project API keys → anon / public
# Безопасен для использования на клиенте. Защищён RLS-политиками.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key — ТОЛЬКО НА СЕРВЕРЕ
# Найти: Supabase Dashboard → Settings → API → Project API keys → service_role
# ВНИМАНИЕ: обходит RLS. Никогда не использовать на клиенте и не коммитить в git.
SUPABASE_SERVICE_ROLE_KEY=
